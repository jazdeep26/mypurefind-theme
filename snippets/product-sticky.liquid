{% assign hidden_price = settings.hidden_price %}
<div
  id="bls__sticky-addcart"
  class="bls__sticky-addcart{% if st.sticky_mode == '1' %} only-show-desktop d-none d-lg-block{% endif %} gradient color-default-color-scheme z-4 fixed inset-x-0 bottom-0 box-shadow-top"
>
  {%- if product.metafields.custom.external_affiliate == blank -%}
    <product-form class="product-form">
      {%- assign product_form_id = 'sticky-addcart-form-' | append: section.id -%}
      {%- form 'product',
        product,
        id: product_form_id,
        novalidate: 'novalidate',
        data-type: 'add-to-cart-form'
      -%}
        <input
          type="hidden"
          name="id"
          value="{{ product.selected_or_first_available_variant.id }}"
          disabled
          class="sticky-variant-input"
        >
        {%- comment -%} Sticky Action Buttons - consistent with quick view {%- endcomment -%}
        <div class="sticky-actions-wrapper">
          {%- if settings.show_qv_demo_slots -%}
            <div class="sticky-demo-slots">
              <img
                src="{{ 'icon_hot.svg' | asset_url }}"
                loading="lazy"
                width="12"
                height="16"
              >
              <span class="slots-text primary-color">
                {%- assign slots = 3 -%}
                {{ 'products.product.demo_slots_left_html' | t: slots: slots }}
              </span>
            </div>
          {%- endif -%}
          <div class="sticky-buttons-row">
            <button
              type="submit"
              name="add"
              class="sticky-addtocart-btn"
              {% if product.selected_or_first_available_variant.available == false %}disabled{% endif %}
            >
              <span class="sticky-bag-icon">
                <i class="picon-handbag"></i>
                <span class="sticky-plus-badge">+</span>
              </span>
              <span class="visually-hidden">{{ 'products.product.add_to_cart' | t }}</span>
              <span class="loader-icon"></span>
            </button>
            <button
              type="button"
              class="sticky-demo-btn book-demo-btn"
              data-entry="product"
              data-category="{{ product.collections.first.handle }}"
              data-subcategory="{{ product.type }}"
              data-product="{{ product.handle }}"
              data-variant-id="{{ product.selected_or_first_available_variant.id }}"
              data-has-only-default-variant="{{ product.has_only_default_variant }}"
            >
              <span class="hidden-loading">{{ 'general.book_home_demo' | t }}</span>
              <span class="loader-icon"></span>
            </button>
          </div>
        </div>
      {%- endform -%}
    </product-form>
  {%- else -%}
    <div class="sticky-actions-row">
      <a
        href="{{ product.metafields.custom.external_affiliate.value.external_link }}"
        rel="nofollow"
        target="_blank"
        class="sticky-demo-btn"
      >
        {{- product.metafields.custom.external_affiliate.value.button_text -}}
      </a>
    </div>
  {%- endif -%}
</div>
